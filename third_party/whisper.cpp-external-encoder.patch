 //   - n_threads:  number of threads to use
 //   - mel_offset: offset in the mel spectrogram (i.e. audio offset)
 //
+// The encoder set with whisper_set_external_encoder(): the mel to it, its cross K/V into kv_cross.
+static bool whisper_encode_by_callback(
+        whisper_context & wctx,
+          whisper_state & wstate,
+              const int   mel_offset) {
+    const auto & hp = wctx.model.hparams;
+    const int n_ctx   = hp.n_audio_ctx;
+    const int n_state = hp.n_text_state;
+    const int n_mel   = hp.n_mels;
+    const auto & mel_inp = wstate.mel;
+
+    std::vector<float> mel((size_t) n_mel * 2 * n_ctx, 0.0f);
+    const int i0 = std::min(mel_offset,           mel_inp.n_len);
+    const int i1 = std::min(mel_offset + 2*n_ctx, mel_inp.n_len);
+    for (int j = 0; j < mel_inp.n_mel; ++j) {
+        for (int i = i0; i < i1; ++i) {
+            mel[(size_t) j*2*n_ctx + (i - i0)] = mel_inp.data[(size_t) j*mel_inp.n_len + i];
+        }
+    }
+    if (!wctx.ext_encode(wctx.ext_user_data, mel.data(), n_mel, 2*n_ctx)) {
+        WHISPER_LOG_ERROR("%s: the external encoder failed\n", __func__);
+        return false;
+    }
+
+    ggml_tensor * kc = wstate.kv_cross.k;
+    ggml_tensor * vc = wstate.kv_cross.v;
+    if ((kc->type != GGML_TYPE_F16 && kc->type != GGML_TYPE_F32) || vc->type != kc->type) {
+        WHISPER_LOG_ERROR("%s: unsupported kv_cross type %s\n", __func__, ggml_type_name(kc->type));
+        return false;
+    }
+    const bool   f16   = kc->type == GGML_TYPE_F16;
+    const size_t esize = ggml_element_size(kc);
+    const bool   flash = wctx.params.flash_attn;
+    const int    n_ctx_pad = GGML_PAD(n_ctx, 256);
+    const float  Kscale = pow(float(n_state/hp.n_text_head), -0.25);
+    const size_t n = (size_t) n_ctx * n_state;
+
+    std::vector<float> k(n), v(n), vt;
+    std::vector<ggml_fp16_t> h(f16 ? n : 0);
+    auto put = [&](ggml_tensor * t, const float * src, size_t offset) {
+        if (f16) {
+            ggml_fp32_to_fp16_row(src, h.data(), (int64_t) n);
+            ggml_backend_tensor_set(t, h.data(), offset, n*esize);
+        } else {
+            ggml_backend_tensor_set(t, src, offset, n*esize);
+        }
+    };
+    for (int il = 0; il < hp.n_text_layer; ++il) {
+        if (!wctx.ext_cross(wctx.ext_user_data, il, k.data(), v.data())) {
+            WHISPER_LOG_ERROR("%s: the external encoder gave no K/V for layer %d\n", __func__, il);
+            return false;
+        }
+        for (float & x : k) x *= Kscale;
+        if (flash) {
+            // As whisper_build_graph_cross: [n_ctx][n_state] per layer, layers n_ctx_pad apart.
+            put(kc, k.data(), esize*n_state*((size_t) il*n_ctx_pad));
+            put(vc, v.data(), esize*n_state*((size_t) il*n_ctx_pad));
+        } else {
+            // K as above with layers n_ctx apart; V transposed, [n_state][n_ctx].
+            put(kc, k.data(), esize*n_state*((size_t) il*n_ctx));
+            vt.resize(n);
+            for (int c = 0; c < n_ctx; ++c) {
+                for (int s = 0; s < n_state; ++s) vt[(size_t) s*n_ctx + c] = v[(size_t) c*n_state + s];
+            }
+            put(vc, vt.data(), esize*n_state*((size_t) il*n_ctx));
+        }
+    }
+    return true;
+}
