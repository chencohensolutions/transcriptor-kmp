@@ -0,0 +1,75 @@
+// sherpa-onnx/csrc/qnn/speaker-embedding-extractor-qnn-impl.h
+//
+// Speaker embeddings on a Qualcomm NPU (QNN HTP) from context binaries of a
+// WeSpeaker-style model compiled for fixed lengths.
+//
+// qnn_config.context_binary lists one or more context binaries, comma
+// separated, each a graph of one fixed number of frames T: input
+// [1, 80, T] (80-dim fbank, transposed, as QNN's converter lays it out; any
+// mean normalization is inside the graph), output [1, dim]. The extractor
+// covers any length with them: shorter than the smallest graph, the frames
+// are repeated to fill it; longer, windows of the largest graph that fits,
+// spread evenly from the first frame to the last (overlapping as needed).
+// The prints of the windows are L2-normalized and averaged, and the average
+// L2-normalized.
+#ifndef SHERPA_ONNX_CSRC_QNN_SPEAKER_EMBEDDING_EXTRACTOR_QNN_IMPL_H_
+#define SHERPA_ONNX_CSRC_QNN_SPEAKER_EMBEDDING_EXTRACTOR_QNN_IMPL_H_
+
+#include <memory>
+#include <mutex>  // NOLINT
