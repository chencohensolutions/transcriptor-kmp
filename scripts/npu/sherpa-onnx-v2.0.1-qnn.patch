+SpeakerEmbeddingExtractorQnnImpl::SpeakerEmbeddingExtractorQnnImpl(
+    const SpeakerEmbeddingExtractorConfig &config)
+    : config_(config) {
+  const auto &qnn = config_.qnn_config;
+  std::vector<std::string> files;
+  SplitStringToVector(qnn.context_binary, ",", true, &files);
+  if (files.empty()) {
+    throw std::runtime_error("speaker embedding (QNN): no context binary");
+  }
+
+  for (const auto &f : files) {
+    if (!FileExists(f)) {
+      throw std::runtime_error("speaker embedding (QNN): '" + f +
+                               "' does not exist");
+    }
+    Graph g;
+    g.backend = std::make_unique<QnnBackend>(qnn.backend_lib, config_.debug);
+    g.model = std::make_unique<QnnModel>(f, qnn.system_lib, g.backend.get(),
+                                         BinaryContextTag{}, config_.debug);
+    if (g.model->InputTensorNames().size() != 1 ||
+        g.model->OutputTensorNames().size() != 1) {
+      throw std::runtime_error("speaker embedding (QNN): '" + f +
+                               "' needs one input and one output");
+    }
+    g.input = g.model->InputTensorNames()[0];
+    g.output = g.model->OutputTensorNames()[0];
+
+    // [1, feat_dim, T] in, [1, dim] out
+    auto in = g.model->TensorShape(g.input);
+    auto out = g.model->TensorShape(g.output);
+    if (in.size() != 3 || in[0] != 1 || in[1] != feat_dim_ || out.empty()) {
+      throw std::runtime_error("speaker embedding (QNN): '" + f +
+                               "' input must be [1, 80, T]");
+    }
+    g.frames = in[2];
+    int32_t dim = out.back();
+    if (dim_ != 0 && dim != dim_) {
+      throw std::runtime_error(
+          "speaker embedding (QNN): the context binaries' output sizes differ");
+    }
+    dim_ = dim;
+
+    if (config_.debug) {
+      SHERPA_ONNX_LOGE("speaker embedding (QNN): '%s': %d frames, dim %d",
+                       f.c_str(), g.frames, dim_);
+    }
+    graphs_.push_back(std::move(g));
+  }
+
+  std::sort(graphs_.begin(), graphs_.end(),
+            [](const Graph &a, const Graph &b) { return a.frames < b.frames; });
+}
+
+SpeakerEmbeddingExtractorQnnImpl::~SpeakerEmbeddingExtractorQnnImpl() {
+  // models before their backends
+  for (auto &g : graphs_) g.model.reset();
+}
+
+std::unique_ptr<OnlineStream> SpeakerEmbeddingExtractorQnnImpl::CreateStream()
+    const {
+  // as for WeSpeaker models (normalize_samples = 0): 80-dim fbank at 16 kHz on
+  // samples scaled to 16-bit range; the graphs do any mean normalization.
+  FeatureExtractorConfig feat_config;
+  feat_config.sampling_rate = 16000;
+  feat_config.feature_dim = feat_dim_;
+  feat_config.normalize_samples = false;
+  return std::make_unique<OnlineStream>(feat_config);
+}
+
+bool SpeakerEmbeddingExtractorQnnImpl::IsReady(OnlineStream *s) const {
+  return s->GetNumProcessedFrames() < s->NumFramesReady();
+}
+
+std::vector<SpeakerEmbeddingExtractorQnnImpl::Window>
+SpeakerEmbeddingExtractorQnnImpl::Plan(int32_t num_frames,
+                                       const std::vector<int32_t> &lengths) {
+  if (num_frames <= 0 || lengths.empty()) return {};
+  if (num_frames <= lengths[0]) return {{0, 0}};
+
+  int32_t g = 0;
+  for (int32_t i = 0; i < static_cast<int32_t>(lengths.size()); ++i) {
+    if (lengths[i] <= num_frames) g = i;
+  }
+  int32_t len = lengths[g];
+  int32_t n = (num_frames + len - 1) / len;
+  if (n == 1) return {{g, 0}};
+
+  std::vector<Window> ans;
+  int32_t last = num_frames - len;
+  for (int32_t i = 0; i < n; ++i) {
+    ans.push_back(
+        {g, static_cast<int32_t>(std::lround(static_cast<double>(i) * last /
+                                             (n - 1)))});
+  }
+  return ans;
+}
+
+std::vector<float> SpeakerEmbeddingExtractorQnnImpl::Run(
+    const Graph &g, const float *features, int32_t num_frames,
+    int32_t start) const {
+  // [T, feat_dim] (repeating the frames if there are fewer than T) ->
+  // [feat_dim, T]
+  int32_t t = g.frames;
+  std::vector<float> x(static_cast<size_t>(t) * feat_dim_);
+  for (int32_t i = 0; i < t; ++i) {
+    int32_t src = num_frames >= start + t ? start + i : (i % num_frames);
+    const float *row = features + static_cast<size_t>(src) * feat_dim_;
+    for (int32_t k = 0; k < feat_dim_; ++k) {
+      x[static_cast<size_t>(k) * t + i] = row[k];
+    }
+  }
+
+  if (!g.model->SetInputTensorData(g.input, x.data(), x.size())) {
+    throw std::runtime_error("speaker embedding (QNN): failed to set input");
+  }
+  if (!g.model->Run()) {
+    throw std::runtime_error("speaker embedding (QNN): failed to run");
+  }
+  auto y = g.model->GetOutputTensorData(g.output);
+  if (static_cast<int32_t>(y.size()) != dim_) {
+    throw std::runtime_error("speaker embedding (QNN): unexpected output size");
+  }
+  return y;
+}
+
+std::vector<float> SpeakerEmbeddingExtractorQnnImpl::Compute(
+    OnlineStream *s) const {
+  int32_t num_frames = s->NumFramesReady() - s->GetNumProcessedFrames();
+  if (num_frames <= 0) {
+    SHERPA_ONNX_LOGE("Please make sure IsReady(s) returns true. num_frames: %d",
+                     num_frames);
+    return {};
+  }
+
+  std::vector<float> features =
+      s->GetFrames(s->GetNumProcessedFrames(), num_frames);
+  s->GetNumProcessedFrames() += num_frames;
+
+  std::vector<int32_t> lengths;
+  for (const auto &g : graphs_) lengths.push_back(g.frames);
+
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::vector<double> sum(dim_, 0.0);
+  for (const auto &w : Plan(num_frames, lengths)) {
+    auto y = Run(graphs_[w.graph], features.data(), num_frames, w.start);
+    double n = 0;
+    for (float v : y) n += static_cast<double>(v) * v;
+    n = std::sqrt(n);
+    if (n <= 0) continue;
+    for (int32_t i = 0; i < dim_; ++i) sum[i] += y[i] / n;
+  }
+
+  double n = 0;
+  for (double v : sum) n += v * v;
+  n = std::sqrt(n);
+  std::vector<float> ans(dim_);
+  for (int32_t i = 0; i < dim_; ++i) {
+    ans[i] = n > 0 ? static_cast<float>(sum[i] / n) : 0.0f;
+  }
+  return ans;
+}
+
+}  // namespace sherpa_onnx
