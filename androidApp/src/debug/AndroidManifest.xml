<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the UI lab (UiLabActivity), which shows the app's screens with made-up data. Release builds
     never see this file or src/debug. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:exported="true"
            android:label="Transcriptor UI lab"
            android:name=".ui.UiLabActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
